# Тип клиента: bot (Bot API) или userbot (Telethon, личный аккаунт)
TELEGRAM_CLIENT_TYPE=bot

# Для bot: токен от @BotFather
TELEGRAM_BOT_TOKEN=

# Для userbot: credentials с https://my.telegram.org
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=

# LLM API (OpenAI-совместимый)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# Embedding model (для RAG)
EMBEDDING_MODEL=text-embedding-3-small

# Whitelist chat IDs (через запятую). Если пусто — все сообщения проходят.
WHITELIST_CHAT_IDS=
