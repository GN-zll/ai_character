# Secrets only. All other settings are in config.toml

# Telegram (получить на https://my.telegram.org — для userbot)
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=

# Telegram Bot Token (получить от @BotFather — для bot)
TELEGRAM_BOT_TOKEN=

# LLM API Key
LLM_API_KEY=

# Embeddings API Key (routerai.ru или другой провайдер эмбеддингов)
EMBEDDING_API_KEY=

# Private: comma-separated chat IDs (пусто = все могут писать)
WHITELIST_CHAT_IDS=

# Private: owner info
OWNER_NAME=YourName
OWNER_CHAT_ID=0
